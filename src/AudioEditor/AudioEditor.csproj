name: Build and publish Windows app

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

jobs:
  build:
    runs-on: windows-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '8.0.x'

      - name: Restore
        run: dotnet restore .\src\AudioEditor\AudioEditor.csproj

      - name: Build
        run: dotnet build .\src\AudioEditor\AudioEditor.csproj -c Release --no-restore

      - name: Publish single-file app
        run: dotnet publish .\src\AudioEditor\AudioEditor.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:UseAppHost=true -p:IncludeNativeLibrariesForSelfExtract=true --output .\artifacts\win-x64

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: audio-editor-win-x64
          path: .\artifacts\win-x64
